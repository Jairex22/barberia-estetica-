# ============================================================
# ClickFlow Digital — variables de entorno (plantilla, sin secretos reales)
# Copia este archivo a ".env" en la raíz del proyecto y completa los valores.
# ============================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Origen público del sitio (usado para CORS en desarrollo y enlaces absolutos)
PUBLIC_URL=http://localhost:4000

# --- Base de datos SQLite (persistente) ---
# Ruta del archivo de base de datos. En producción debe apuntar a un volumen
# persistente (no a un sistema de archivos efímero).
DATABASE_PATH=./server/data/app.sqlite

# --- Sesiones / seguridad ---
# Cadena aleatoria larga y secreta (genera una nueva para cada instalación).
# Ejemplo para generar una: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-esta-clave-por-una-aleatoria-y-larga
# "true" en producción con HTTPS para exigir cookies Secure
COOKIE_SECURE=false

# --- Primer administrador (solo se usa una vez, al iniciar con la BD vacía) ---
# IMPORTANTE: si tu contraseña incluye el símbolo "#", enciérrala entre comillas
# dobles (ej. ADMIN_BOOTSTRAP_PASSWORD="Segura#2026"), porque dotenv trata un "#"
# sin comillas como inicio de comentario y truncaría el valor.
ADMIN_BOOTSTRAP_EMAIL=admin@tudominio.com
ADMIN_BOOTSTRAP_PASSWORD=defina-una-contrasena-fuerte-unica

# --- Proveedor de Inteligencia Artificial (bot) ---
# Proveedor soportado actualmente: "anthropic"
AI_PROVIDER=anthropic
# Clave de API real del proveedor (NUNCA la subas a git ni la expongas al frontend)
ANTHROPIC_API_KEY=
# Modelo a utilizar (ver documentación oficial: https://docs.claude.com/en/docs/about-claude/models)
AI_MODEL=claude-haiku-4-5-20251001
# Límites de uso del bot
AI_MAX_MESSAGES_PER_SESSION=30
AI_MAX_INPUT_CHARS=800
AI_MAX_TOKENS_RESPONSE=500
AI_GLOBAL_DAILY_MESSAGE_LIMIT=500
# Días de retención de conversaciones del bot antes de poder purgarse
AI_CONVERSATION_RETENTION_DAYS=30

# --- WhatsApp / contacto (se configuran también desde /admin) ---
DEFAULT_WHATSAPP_NUMBER=5210000000000
