# ===================== Sobremesa — variables de entorno (SIN secretos reales) =====================
# Copia a apps/api/.env (API) y apps/web/.env.local (web). Nunca subas .env al repositorio.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://citas:citas@127.0.0.1:5432/citas
APP_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
COOKIE_SECRET=cambia-esto-por-32-caracteres-aleatorios
MEDIA_SIGNING_SECRET=cambia-esto-por-32-caracteres-aleatorios
COOKIE_SECURE=false            # true detrás de HTTPS en producción
TRUST_PROXY=false              # true si hay un proxy inverso (Fly, Render, Nginx)
SESSION_TTL_DAYS=30
INITIATION_POLICY_MIXED=either # either | non_man_first (combinaciones con no binario/otro)
DEMO_MODE=false                # true SOLO en entornos de demostración: muestra perfiles marcados "Demostración"
JOBS_ENABLED=true
DELETED_ACCOUNT_RETENTION_DAYS=30
LOG_LEVEL=info

# Correo transaccional: console (desarrollo) | resend
EMAIL_PROVIDER=console
EMAIL_FROM="Sobremesa <no-reply@tudominio.mx>"
RESEND_API_KEY=

# Almacenamiento privado de fotos: local (desarrollo) | s3 (Cloudflare R2 / S3 compatible)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/private
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Stripe (web). Requiere aprobación previa del giro "dating" por Stripe. Usa claves de TEST hasta producción.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MXN=      # price_... mensual en MXN (IVA incluido)
STRIPE_PRICE_PREMIUM_USD=      # opcional

# Mercado Pago (diseñado, NO probado en sandbox en este entorno). Déjalo vacío hasta completar docs/pagos.md.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PREMIUM_AMOUNT_MXN=199

# RevenueCat (App Store / Google Play)
REVENUECAT_WEBHOOK_SECRET=     # el mismo valor que configures como Authorization en el webhook de RevenueCat
REVENUECAT_SECRET_API_KEY=     # opcional: permite "Restaurar compras" verificando con RevenueCat

# Precios mostrados (centavos). Deben coincidir con los configurados en Stripe/tiendas.
PREMIUM_PRICE_MXN_MINOR=19900
PREMIUM_PRICE_USD_MINOR=999

# Asistente de soporte (Anthropic). Sin clave, responde con FAQ (modo degradado honesto).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_MAX_OUTPUT_TOKENS=600
ASSISTANT_TIMEOUT_MS=20000
ASSISTANT_DAILY_MSGS_PER_USER=30
ASSISTANT_MONTHLY_BUDGET_USD=20
ASSISTANT_PRICE_IN_PER_MTOK_USD=0.10   # Haiku 5.5 (verificar en platform.claude.com/docs/en/about-claude/pricing)
ASSISTANT_PRICE_OUT_PER_MTOK_USD=0.50

# Moderación automática de imágenes: none (todo a revisión humana) | sightengine
IMAGE_MODERATION_PROVIDER=none
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# --- Móvil (apps/mobile/.env) ---
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000      # emulador Android; usa la IP de tu PC para dispositivo físico
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
